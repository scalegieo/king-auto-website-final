# King Auto — Dealr inventory export (provide to Dealr support)
# Vendor: MediPath AI / King Auto website (Next.js on Vercel)

# FTP feed (Dealr Scale/custom FTP — Adam @ Dealr technical support)
DEALR_FTP_HOST=
DEALR_FTP_USERNAME=
DEALR_FTP_PASSWORD=
DEALR_FTP_FILENAME=inventory.csv
# Set to true if Dealr uses FTPS
DEALR_FTP_SECURE=false

# Optional: HTTP URL if Dealr publishes CSV to a URL instead of FTP
DEALR_INVENTORY_URL=

# Dev only: local CSV path (defaults to data/sample-dealr-inventory.csv in development)
# DEALR_INVENTORY_FILE=data/sample-dealr-inventory.csv

# How often Next.js revalidates inventory (seconds)
INVENTORY_REVALIDATE_SECONDS=300

# Optional: protect manual sync endpoint (see app/api/inventory/refresh)
INVENTORY_SYNC_SECRET=

# Optional. Admin “Publish to live site” POSTs this Vercel deploy hook.
# VERCEL_DEPLOY_HOOK=
# Weekly SEO job (Vercel Cron sends Authorization: Bearer CRON_SECRET)
CRON_SECRET=
# Optional extra dashboard password. Footer Admin also accepts the lot PIN.
SEO_ADMIN_SECRET=
# Optional persistent directory. Defaults to data/seo
# SEO_DATA_DIR=
# Optional remote JSON store for hosts with a read-only disk (GET + PUT).
# SEO_STATE_URL=
# SEO_STATE_TOKEN=
# Optional Search Console service account JSON (one line) and property URL.
# GOOGLE_SEARCH_CONSOLE_JSON=
# SEARCH_CONSOLE_SITE_URL=https://www.shopkingauto.com/
# Google Analytics 4. The measurement ID sends visits to Google. The property ID
# plus the same service account JSON lets the admin page read those numbers back.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA4_PROPERTY_ID=
# GOOGLE_ANALYTICS_JSON=

# Lead forms (pre-approval + vehicle match) POST to a hardcoded Apps Script URL
# in lib/king-auto-leads.ts — no env required for production lead capture.
# Legacy GOOGLE_SHEETS_CRM_WEBHOOK vars are unused by current forms.

# OpenRouter chat key is hardcoded in lib/openrouter-chat.ts (no env required).
# Optional override:
# OPENROUTER_API_KEY=
